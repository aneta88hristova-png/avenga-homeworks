@{
    ViewData["Title"] = "Home";
}

<h1>Welcome to Video Rental Store!</h1>

@if (ViewBag.UserName != null)
{
    <p>Welcome back, <strong>@ViewBag.UserName</strong>!</p>
    <p>
        <a href="/Movies/Index">Browse Movies</a> |
        <a href="/Movies/MyRentals">My Rentals</a> |
        <a href="/Home/Logout">Logout</a>
    </p>
}
else
{
    <p>Please login to start renting movies.</p>
    <a href="/Home/Login">Login</a>
}