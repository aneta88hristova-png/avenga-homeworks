@page
@model RazorFormDemo.Pages.Users.ConfirmationModel

@{
    ViewData["Title"] = "Confirmation";
}

<div class="text-center">
    <h1>Thank You for Registering!</h1>

    <div class="alert alert-success">
        @Model.Message
    </div>

    <div class="mt-5">
        <h3>All Registered Users</h3>

        @if (Model.AllUsers.Any())
        {
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Email</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.AllUsers)
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td>@user.FirstName</td>
                            <td>@user.LastName</td>
                            <td>@user.Email</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="text-muted">Total users: @Model.AllUsers.Count</p>
        }
        else
        {
            <p class="text-muted">No users registered yet.</p>
        }
    </div>

    <div class="mt-4">
        <a asp-page="./Register" class="btn btn-primary">
            Register Another User
        </a>
    </div>
</div>