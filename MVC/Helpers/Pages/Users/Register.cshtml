@page
@model RazorFormDemo.Pages.Users.RegisterModel

@{
    ViewData["Title"] = "Register User";
}

<h1>Register User</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<!-- ============================================ -->
<!-- 1. HTML HELPERS -->
<!-- ============================================ -->
<h2>1. Form with HTML Helpers</h2>

@using (Html.BeginForm("Register", "Users", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.UserInfo.FirstName, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.UserInfo.FirstName, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.UserInfo.FirstName, "", new { @class = "text-danger" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.UserInfo.LastName, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.UserInfo.LastName, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.UserInfo.LastName, "", new { @class = "text-danger" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.UserInfo.Email, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.UserInfo.Email, new { @class = "form-control", type = "email" })
        @Html.ValidationMessageFor(m => m.UserInfo.Email, "", new { @class = "text-danger" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.UserInfo.Password, new { @class = "form-label" })
        @Html.PasswordFor(m => m.UserInfo.Password, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.UserInfo.Password, "", new { @class = "text-danger" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.UserInfo.ConfirmPassword, new { @class = "form-label" })
        @Html.PasswordFor(m => m.UserInfo.ConfirmPassword, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.UserInfo.ConfirmPassword, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary">Register (HTML Helper)</button>
}

<hr />

<!-- ============================================ -->
<!-- 2. TAG HELPERS -->
<!-- ============================================ -->
<h2>2. Form with Tag Helpers</h2>

<form method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="UserInfo.FirstName" class="form-label"></label>
        <input asp-for="UserInfo.FirstName" class="form-control" />
        <span asp-validation-for="UserInfo.FirstName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="UserInfo.LastName" class="form-label"></label>
        <input asp-for="UserInfo.LastName" class="form-control" />
        <span asp-validation-for="UserInfo.LastName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="UserInfo.Email" class="form-label"></label>
        <input asp-for="UserInfo.Email" class="form-control" type="email" />
        <span asp-validation-for="UserInfo.Email" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="UserInfo.Password" class="form-label"></label>
        <input asp-for="UserInfo.Password" class="form-control" type="password" />
        <span asp-validation-for="UserInfo.Password" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="UserInfo.ConfirmPassword" class="form-label"></label>
        <input asp-for="UserInfo.ConfirmPassword" class="form-control" type="password" />
        <span asp-validation-for="UserInfo.ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Register (Tag Helper)</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}